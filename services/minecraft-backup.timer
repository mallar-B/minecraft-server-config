[Unit]
Description=Minecraft Backup Every Five Hours

[Timer]
# Run fifteen minutes after boot.
OnBootSec=15min

# Schedule the next backup five hours after the previous backup started.
OnUnitActiveSec=5h

# If the machine resumes from sleep after the timer was due, run it promptly.
WakeSystem=false

AccuracySec=1min
Unit=minecraft-backup.service

[Install]
WantedBy=timers.target
